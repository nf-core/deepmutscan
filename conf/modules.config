/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    Output layout: Outputs are published directly into functional directories
    under `${outdir}/...` without sample-specific or reference parent folders.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'RAW_DATA_QC' {
        // ext.args -> fq lint; ext.args2 -> falco (--groups: positions binned as in FastQC's default
        // report). Published: Falco's report, FastQC-format data and module summary of every FASTQ
        // file. The fq lint result only feeds the start-of-run check and its log message.
        ext.args2 = '--groups'
        publishDir = [
            path: { "${params.outdir}/raw_data_qc" },
            mode: params.publish_dir_mode,
            pattern: '*_{fastqc_data.txt,falco_report.html,falco_summary.txt}'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    // --- Reference-derived, merged into intermediate_files ---

    withName: 'PREPARE_REFERENCE' {
        // one task per run: the reference FASTA in upper case (<name>.uppercase.fasta) and its bwa-mem3
        // index. Only the index is published; the run's reference is in the reports.
        // A gene-sized reference needs little: static resources.
        cpus   = 1
        memory = 1.GB
        time   = 30.min
        publishDir = [
            path: "${params.outdir}/intermediate_files",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'bwamem3' ? filename : null }
        ]
    }

    withName: 'DMSANALYSIS_REFERENCE_TABLES' {
        publishDir = [
            path: "${params.outdir}/intermediate_files",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // --- Read merging / alignment / filtering / counting ---

    withName: 'MERGE_ALIGN_COUNT' {
        // Merges the raw read pairs (vsearch), aligns the merged reads (bwa-mem3), filters them
        // (samtools) and counts the variants (dms_count), streamed in one task. args -> vsearch
        // read-pair merging; args2 -> samtools filter on the aligned merged reads: drop unmapped,
        // secondary and supplementary records (0x904) and anything below MAPQ 30. Reads with indels
        // pass the filter and are skipped by the counter (dms_count --skip_indel_reads).
        ext.args  = '--fastq_minovlen 10 --fastq_allowmergestagger'
        ext.args2 = '-F 0x904 -q 30'
        // args3 -> bwa-mem3 mem: end-to-end alignment of substitutions (clipping penalty 100), gap open 12
        // and mismatch 3, so that multi-base codon changes near a read end are neither soft-clipped away
        // nor realigned as indels (see the module for the measured effect), plus bwa-mem3's --fast preset
        // (not byte-reproducible across bwa-mem3 versions; on the test libraries it changes one read in one
        // library). Drop --fast in a custom config for byte-identical alignments to bwa 0.7.19.
        //
        // --sequencing tiled: reads of a tiled amplicon run past both ends of a tile-sized reference,
        // usually with a variable spacer beyond the constant flanks. With the clipping penalty of 100,
        // bwa-mem3 aligns those overhanging bases as an insertion next to the reference end, and the
        // counter skips every read with an indel (89-99.5 % of the reads of three tiled libraries). The
        // default clipping penalty (-L 5) clips them instead; the module adds the constant flanks to the
        // reference if they are missing, so the clip never reaches a codon of the tile. -y 20 restores
        // bwa's third seeding round, which --fast turns off (-y 0): without it, BWA-MEM misses the exact
        // match of a read that contains the whole reference, 0.2-5 % of the wildtype reads of a tile.
        ext.args3 = { params.sequencing == 'tiled' ? '--fast -y 20 -L 5 -O 12,12 -B 3' : '--fast -L 100 -O 12,12 -B 3' }
        // args4 -> dms_count (extra options, none by default)
        // Published: the merging statistics, the variant counts per library, and - only with
        // --save_bam - a coordinate-sorted, indexed BAM of the filtered alignments, which the counter
        // itself does not need.
        publishDir = [
            [
                path: { "${params.outdir}/intermediate_files/merged_reads" },
                mode: params.publish_dir_mode,
                pattern: '*.{log,tiled_flanks.tsv}'
            ],
            [
                path: { "${params.outdir}/intermediate_files/bam_files/sorted" },
                mode: params.publish_dir_mode,
                pattern: '*.sorted.bam*',
                enabled: params.save_bam
            ],
            [
                path: { "${params.outdir}/intermediate_files/variant_counts" },
                mode: params.publish_dir_mode,
                pattern: '{*.variant_counts.tsv,variant_counts_columns.tsv}',
                saveAs: { filename -> "${meta.id}/${filename}" }
            ]
        ]
    }

    // --- Variant processing / error correction (per-replicate meta.id subfolder) ---

    withName: 'DMSANALYSIS_PROCESS_VARIANT_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/intermediate_files/processed_variant_counts" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'versions.yml') return null
                "${meta.id}/${filename}"
            }
        ]
    }

    // False-doubles correction, step 1: per-library evidence, next to the library's other count tables
    withName: 'DMSANALYSIS_FDM_EVIDENCE' {
        publishDir = [
            path: { "${params.outdir}/intermediate_files/processed_variant_counts" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename == 'versions.yml') return null
                "${meta.id}/${filename}"
            }
        ]
    }

    // False-doubles correction, step 2: one error-rate fit per pool of libraries (--false_doubles_pooling)
    withName: 'DMSANALYSIS_FDM_ESTIMATE' {
        publishDir = [
            path: { "${params.outdir}/intermediate_files/false_doubles_pools" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename == 'versions.yml') return null
                "${meta.id}/${filename}"
            }
        ]
    }

    // False-doubles correction, reporting: signature fit of each pool's error spectrum
    withName: 'DMSANALYSIS_ERROR_SIGNATURES' {
        publishDir = [
            path: { "${params.outdir}/error_signatures" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename == 'versions.yml') return null
                "${meta.id}/${filename}"
            }
        ]
    }

    withName: 'DMSANALYSIS_ERROR_CORRECTION_.*' {
        publishDir = [
            path: { "${params.outdir}/intermediate_files/processed_variant_counts" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'versions.yml') return null
                "${meta.id}/${filename}"
            }
        ]
    }

    // The per-library QC plots (one task per library) file under library_QC/<library>/
    withName: 'VISUALIZATION_LIBRARY_QC' {
        publishDir = [
            path: { "${params.outdir}/library_QC" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'versions.yml') return null
                "${meta.id}/${filename}"
            }
        ]
    }

    // Run-level, so it has no meta.id to file itself under - published flat under library_QC.
    withName: 'VISUALIZATION_ERROR_CORRECTION_REPORT' {
        publishDir = [
            path: { "${params.outdir}/library_QC" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // The all-in-one report is the flagship output - published at the results root, not buried.
    withName: 'VISUALIZATION_SUMMARY_REPORT' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // --- Fitness and Experimental Design ---

    // Per-library DiMSum input tables: published only when DiMSum runs (they are intermediate otherwise)
    withName: 'COUNTS_TO_FITNESS' {
        publishDir = [
            path: { "${params.outdir}/fitness/DiMSum_results/single_rep_counts" },
            enabled: params.dimsum.toString() != 'false',
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // Default fitness estimation, one task per sample: the merged counts, the experimental design and
    // the synonymous wildtype proxy file under fitness/, the fitness table and its plots under
    // fitness/default_results/
    withName: 'FITNESS_ESTIMATION' {
        publishDir = [
            [
                path: { "${params.outdir}/fitness" },
                mode: params.publish_dir_mode,
                pattern: '{counts_merged.tsv,experimentalDesign.tsv,synonymous_wt.txt}'
            ],
            [
                path: { "${params.outdir}/fitness/default_results" },
                mode: params.publish_dir_mode,
                pattern: '{fitness_estimation.tsv,*.pdf}'
            ]
        ]
    }

    withName: 'RUN_DIMSUM' {
        // --mixedSubstitutions T: the synonymous wildtype proxy can differ from the reference by one
        // codon; with DiMSum's default (F), single mutants of the proxy would be discarded as
        // "mixed substitutions". --fitnessErrorModel from --dimsum_error_model (default true): the
        // error model needs at least 30 well-covered variants per replicate, which the subsampled
        // test data lack (the test profile switches it off).
        ext.args = { "--mixedSubstitutions T --fitnessErrorModel ${params.dimsum_error_model.toString().toBoolean() ? 'T' : 'F'} --retainIntermediateFiles T" }
        publishDir = [
            path: { "${params.outdir}/fitness/DiMSum_results" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'RUN_MUTSCAN' {
        publishDir = [
            path: { "${params.outdir}/fitness/mutscan_results" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'VARIANT_EFFECT_INSPECTION_TOOL' {
        publishDir = [
            path: { "${params.outdir}/variant_effect_inspection_tool" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}
