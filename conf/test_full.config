/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/deepmutscan -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Input data for full size test
    // GluePCA GID1A-GAI shotgun DMS (ENA PRJEB110196): 3 input and 3 output (2500 uM GA3) replicates,
    // 2x150 bp, ~480M read pairs in total. The samplesheet links the FASTQs on ENA.
    // The minimal `test` profile uses 50k read-pair subsamples of the same libraries.
    input = params.pipelines_testdata_base_path + 'deepmutscan/samplesheet/GID1A_full.csv'
    fasta = params.pipelines_testdata_base_path + 'deepmutscan/testdata/GID1A.fasta'
    reading_frame    = '352-1383'
    mutagenesis_type = 'nnk_nns'
    fitness = true
    mutscan = true
    dimsum  = true

    // Precomputed wildtype structure (AlphaFold DB model, GID1A / UniProt Q9MAA7, CC-BY-4.0) so the
    // interactive variant effect inspection tool runs end-to-end without structure prediction.
    pdb = params.pipelines_testdata_base_path + 'deepmutscan/testdata/GID1A_AFDB.pdb'
}
